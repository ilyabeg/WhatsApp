<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    
                    xmlns:models="clr-namespace:Client.Client_Related;assembly=Client"
                    xmlns:UDP="clr-namespace:Client.UDP;assembly=Client"
                    xmlns:TCP="clr-namespace:Client.TCP;assembly=Client">
                    
    <!-- UdpClient Grid with 3 group chat Buttons -->
    <DataTemplate DataType="{x:Type UDP:ClientUDP}">
        <Grid>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" >
                
                <Button Content="New Group" Style="{StaticResource GroupOptionButton}"
                        Command="{Binding DataContext.NewGroupCommand, 
                        RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                
                <Button Content="Join Group" Style="{StaticResource GroupOptionButton}"
                        Command="{Binding DataContext.JoinGroupCommand, 
                        RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <Button Content="Leave Group" Style="{StaticResource GroupOptionButton}"
                        Command="{Binding DataContext.LeaveGroupCommand, 
                        RelativeSource={RelativeSource AncestorType=UserControl}}" />

            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Regular Grid for TCP client -->
    <DataTemplate DataType="{x:Type TCP:ClientTCP}"> 
        <Grid />
    </DataTemplate>

    <!-- Material Design ChatUser Template (UDP/TCP clients) -->
    <DataTemplate DataType="{x:Type models:ChatUser}">
        <StackPanel Orientation="Horizontal" Margin="8,4">

            <!-- Material User Icon -->
            <materialDesign:PackIcon Kind="Account" 
                                 Width="24" Height="24" 
                                 Foreground="Gray" 
                                 Margin="0,0,12,0" 
                                 VerticalAlignment="Center"/>

            <TextBlock Text="{Binding ChatItemName}" 
                   FontSize="15" 
                   VerticalAlignment="Center" 
                   FontWeight="Medium"/>
        </StackPanel>
    </DataTemplate>

    <!-- Material Design GroupChat Template -->
    <DataTemplate DataType="{x:Type models:GroupChat}">
        <StackPanel Orientation="Horizontal" Margin="8,4">

            <!-- Material Group Icon -->
            <materialDesign:PackIcon Kind="AccountGroup" 
                                 Width="24" Height="24" 
                                 Foreground="#0078D7" 
                                 Margin="0,0,12,0" 
                                 VerticalAlignment="Center"/>

            <TextBlock Text="{Binding ChatItemName}" 
                   FontSize="15" 
                   VerticalAlignment="Center" 
                   FontWeight="Bold" />

            <TextBlock Text="{Binding MembersCount, StringFormat=' ({0})'}" 
                   FontSize="13" 
                   Foreground="{StaticResource PrimaryTextBrush}"
                   VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>