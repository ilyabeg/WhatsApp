<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SendButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BtnBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BtnTextBrush}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="10,15,15,15" />
        <Setter Property="Width" Value="65" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect 
                                Color="{StaticResource Darkest}"
                                BlurRadius="8"
                                Opacity=".5"
                                ShadowDepth="4"/>
                        </Border.Effect>
                        <ContentPresenter Content="Send" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClearButtonStyle" TargetType="Button">
        <Setter Property="Content" Value="X" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource PlaceHolderTextBrush}" />
    </Style>

    <Style x:Key="RegisterButtonStye" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BtnBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BtnTextBrush}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="15,15,15,85" />
        <Setter Property="Width" Value="150" />
        <Setter Property="Height" Value="50" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="20">
                        <Border.Effect>
                            <DropShadowEffect 
                            Color="{StaticResource Darkest}"
                            BlurRadius="8"
                            Opacity=".5"
                            ShadowDepth="4"/>
                        </Border.Effect>
                        <ContentPresenter Content="Register" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- UDP client Group chats button options style -->
    <Style x:Key="GroupOptionButton" TargetType="Button" >
        <Setter Property="Background" Value="{StaticResource ChatBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value=".5" />
        <Setter Property="BorderBrush" Value="{StaticResource PlaceHolderTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="2,1,2,1"/>
        <Setter Property="Height" Value="Auto" />
    </Style>

</ResourceDictionary>