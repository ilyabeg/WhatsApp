<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlaceHolderStyle" TargetType="TextBlock" >
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Text" Value="Enter Message Here..." />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource PlaceHolderTextBrush}" />
        <Setter Property="Margin" Value="15,0,0,0" />
    </Style>

    <Style x:Key="UsernameBlockStyle" TargetType="TextBlock" >
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="20,0,20,0" />
        <Setter Property="Text" Value="username0000" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{StaticResource HeadersTextBrush}" />
    </Style>

    <Style x:Key="ActiveUsersBlockStyle" TargetType="TextBlock" >
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="Text" Value="Active Users &amp; Groups" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{StaticResource HeadersTextBrush}" />
    </Style>

    <Style x:Key="LoginTextBlockStyle" TargetType="TextBlock" >
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="55,85,55,15" />
        <Setter Property="Text" Value="Please enter Username:" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="45" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource HeadersTextBrush}" />
    </Style>

</ResourceDictionary>