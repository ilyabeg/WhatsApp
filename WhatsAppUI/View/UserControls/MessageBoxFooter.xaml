<UserControl x:Class="WhatsAppUI.View.UserControls.MessageBoxFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WhatsAppUI.View.UserControls"
             mc:Ignorable="d" 
             Height="70" d:DesignWidth="800">

    <Grid Background="{StaticResource InputFooterBrush}">
        <Grid Height="40" Width="695" Margin="15,0,0,0" HorizontalAlignment="Left" Background="White">
            
            <TextBlock Name="PlaceHolderTxt" Background="Transparent" Margin="5,0,35,0"
                    Text="Enter Message Here..." VerticalAlignment="Center"
                    FontSize="17" Foreground="{StaticResource PlaceHolderTextBrush}" />

            <TextBox Name="InputTxt" Background="Transparent" Margin="5,0,30,0"
                    VerticalContentAlignment="Center" FontSize="17" FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"/>

            <Button Name="btnClear" Style="{StaticResource ClearButtonStyle}"/>
        </Grid>

        <Button Name="btnSend" Style="{StaticResource SendButtonStyle}" />
    </Grid>
    
</UserControl>
