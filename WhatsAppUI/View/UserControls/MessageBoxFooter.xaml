<UserControl x:Class="WhatsAppUI.View.UserControls.MessageBoxFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WhatsAppUI.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="800">

    <Grid Background="{StaticResource InputFooterBrush}">

        <Border Style="{StaticResource MessageInputBorderStyle}">
            <Grid>

                <TextBlock Name="PlaceHolderTxt" Style="{StaticResource PlaceHolderStyle}" />
                <TextBox Name="InputTxt" Style="{StaticResource MessageInput}"/>
                <Button Name="btnClear" Style="{StaticResource ClearButtonStyle}"/>
            
            </Grid>
        </Border>

        <Button Name="btnSend" Style="{StaticResource SendButtonStyle}" />
    </Grid>
    
</UserControl>
