<UserControl x:Class="WhatsAppUI.View.UserControls.MessageBoxFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WhatsAppUI.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="800">

    <Grid Background="{StaticResource InputFooterBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource MessageInputBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Name="PlaceHolderTxt" Style="{StaticResource PlaceHolderStyle}" />
                
                <TextBox Grid.Column="0" Name="InputTxt" Style="{StaticResource MessageInput}" TextChanged="InputTxt_TextChanged" />

                <Button Grid.Column="1" Name="btnClear" Style="{StaticResource ClearButtonStyle}" Click="btnClear_Click" />
            </Grid>
        </Border>

        <Button Grid.Column="1" Name="btnSend" Style="{StaticResource SendButtonStyle}" Click="btnSend_Click" />
    </Grid>
    
</UserControl>
