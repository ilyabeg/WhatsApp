<UserControl x:Class="WhatsAppUI.View.UserControls.LoginForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WhatsAppUI.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Background="{StaticResource LoginFormBrush}">

        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0" Stretch="Uniform" Margin="10">
            <TextBlock Name="LoginTxt" Style="{StaticResource LoginTextBlockStyle}" />
        </Viewbox>
        
        <TextBox Grid.Row="1" Name="UsernameInfo" Style="{StaticResource UsernameInput}" />
        
        <Button Grid.Row="2" Name="btnRegister" Style="{StaticResource RegisterButtonStye}"
                Click="btnRegister_Click"/>

    </Grid>
    
</UserControl>
